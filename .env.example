NODE_ENV=development
DATABASE_PATH=./finance.db
# Scheduler lock TTL in milliseconds (default 600000 = 10 minutes)
SCHEDULER_LOCK_TTL_MS=600000

# Reminder: in production, set a conservative TTL based on expected job runtime
# and ensure system clocks are synchronized across instances (NTP).  Example:
# SCHEDULER_LOCK_TTL_MS=1200000  # 20 minutes
# Environment variables
# Salin ke .env dan isi dengan nilai yang sesuai

DATABASE_PATH=./finance.db
PORT=3000
NODE_ENV=development
