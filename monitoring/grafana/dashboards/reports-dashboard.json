{
  "id": null,
  "uid": "reports-weekly",
  "title": "Weekly Reports Overview",
  "timezone": "browser",
  "schemaVersion": 30,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Weekly Reports Generated",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(reports_weekly_generated_total)", "refId": "A" }
      ],
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Weekly Reports Failed",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(reports_weekly_failed_total)", "refId": "A" }
      ],
      "id": 2,
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Weekly Reports Skipped",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(reports_weekly_skipped_total)", "refId": "A" }
      ],
      "id": 3,
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Lock Acquisitions",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(scheduler_lock_acquired_total)", "refId": "A" }
      ],
      "id": 10,
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "graph",
      "title": "Report Generation Duration (s)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(reports_weekly_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(reports_weekly_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" }
      ],
      "id": 4,
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }
    },
    {
      "type": "graph",
      "title": "Audit Events Distribution",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(rate(report_audit_events_total[5m])) by (action)", "legendFormat": "{{ action }}", "refId": "A" }
      ],
      "id": 11,
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 }
    },
    {
      "type": "stat",
      "title": "Last Report Generated",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "time() - report_last_generated_timestamp_seconds", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "id": 12,
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Lock Failures (1h)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "increase(scheduler_lock_failed_total[1h])", "refId": "A" }
      ],
      "id": 13,
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Failure Rate (1h)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "100 * (increase(reports_weekly_failed_total[1h]) / max(1, increase(reports_weekly_failed_total[1h]) + increase(reports_weekly_generated_total[1h])))", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      },
      "id": 14,
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 4 }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}
