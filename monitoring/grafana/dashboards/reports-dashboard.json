{
  "id": null,
  "uid": "reports-weekly",
  "title": "Weekly Reports Overview",
  "timezone": "browser",
  "schemaVersion": 30,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Weekly Reports Generated",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(reports_weekly_generated_total)", "refId": "A" }
      ],
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Weekly Reports Failed",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(reports_weekly_failed_total)", "refId": "A" }
      ],
      "id": 2,
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Weekly Reports Skipped",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(reports_weekly_skipped_total)", "refId": "A" }
      ],
      "id": 3,
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 }
    },
    {
      "type": "graph",
      "title": "Report Generation Duration (s)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(reports_weekly_duration_seconds_bucket[5m])) by (le))", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(reports_weekly_duration_seconds_bucket[5m])) by (le))", "refId": "B" }
      ],
      "id": 4,
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}
