{
  "name": "my-duit",
  "version": "1.0.0",
  "description": "Personal Finance Dashboard - Learning Project",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run watch:css\" \"nodemon server.js\"",
    "build:css": "tailwindcss -i src/css/main.css -o public/css/styles.css",
    "watch:css": "tailwindcss -i src/css/main.css -o public/css/styles.css --watch",
    "init:db": "node migrations/init.js",
    "test": "jest --runInBand",
    "test:api": "node scripts/test-api.js",
    "run:weekly": "node scripts/run-weekly.js",
    "db:seed": "node scripts/seed.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "finance",
    "dashboard",
    "learning"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.2",
    "pino": "^8.14.0",
    "pino-pretty": "^9.2.0",
    "prom-client": "^14.0.0",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "jest": "^29.6.1",
    "nodemon": "^2.0.20",
    "prettier": "^3.8.4",
    "supertest": "^6.3.3",
    "tailwindcss": "^4.3.0"
  }
}
